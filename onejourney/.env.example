# Local SQLite persistence; leave unset for default.
ONEJOURNEY_DB=./onejourney.sqlite3
# Local Ollama GenAI advisor. No API key or hosted provider is used.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_REASONING_EFFORT=none

# Generate two distinct random values locally. Blank keys disable staff access.
ONEJOURNEY_PARTNER_KEY=
ONEJOURNEY_OPS_KEY=
# Enable only on the synthetic demonstration machine.
ONEJOURNEY_DEMO_MODE=0
ONEJOURNEY_FIXTURE_DATE=2026-07-15
