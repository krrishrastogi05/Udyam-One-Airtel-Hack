# Copy to .env and fill in. Never commit or share the real key.
# Without a key the advisor runs fully offline (English, Hindi, Hinglish rules engine).
GEMINI_API_KEY=
# Optional: a different Gemini model
GEMINI_MODEL=gemini-3.8-flash
# Optional, Windows only if Tesseract isn't auto-detected:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Voice (speech-to-text and text-to-speech in Indian languages): https://dashboard.sarvam.ai
SARVAM_API_KEY=
